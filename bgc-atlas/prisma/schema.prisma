  query_aligned            String?
  target_aligned           String?
  alignment_string         String?
  rank                     Int
  created_at               DateTime                 @default(now()) @db.Timestamptz(6)
  sequence_search_sessions sequence_search_sessions @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seq_search_results_session")

  // No relation to Bgc: there is no FK, so bgc_id is a plain parsed UUID that
