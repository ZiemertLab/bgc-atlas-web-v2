generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DataSource {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  source_type    String
  name           String      @db.VarChar(200)
  description    String?
  source_url     String?
  user_upload_id String?     @db.Uuid
  created_at     DateTime?   @default(now()) @db.Timestamptz(6)
  user_upload    UserUpload? @relation(fields: [user_upload_id], references: [id], onUpdate: NoAction)

  @@index([source_type], map: "idx_data_sources_source_type")
  @@index([user_upload_id], map: "idx_data_sources_user_upload_id")
  @@map("data_sources")
}

model UserUpload {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  first_name   String       @db.VarChar(100)
  last_name    String       @db.VarChar(100)
  institution  String?      @db.VarChar(200)
  email        String       @db.VarChar(255)
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  data_sources DataSource[]

  @@index([email], map: "idx_user_uploads_email")
  @@map("user_uploads")
}

model Study {
  id                  String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  external_id         String?
  title               String?
  abstract            String?
  study_type          String?
  study_name          String?
  center_name         String?
  accession           String?       @unique
  bioproject          String?
  secondary_accession String?
  data_source_ids     String[]      @default([]) @db.Uuid
  biome_ids           String[]      @default([]) @db.Uuid
  metadata            Json          @default("{}")
  created_at          DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?     @default(now()) @db.Timestamptz(6)
  run_studies         RunStudy[]
  study_biomes        StudyBiome[]
  study_samples       StudySample[]

  @@index([biome_ids], map: "idx_studies_biome_ids_gin", type: Gin)
  @@index([data_source_ids], map: "idx_studies_data_source_ids_gin", type: Gin)
  @@index([metadata], map: "idx_studies_metadata_gin", type: Gin)
  @@map("studies")
}

model Sample {
  id                            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  external_id                   String?             @unique
  name                          String?
  description                   String?
  collection_date               DateTime?           @db.Date
  collection_date_end           DateTime?           @db.Date
  geographic_location           String?
  location_resolution           String?
  latitude                      Decimal?            @db.Decimal
  longitude                     Decimal?            @db.Decimal
  depth                         Decimal?            @db.Decimal(10, 3)
  depth_min_meters              Decimal?            @db.Decimal
  depth_max_meters              Decimal?            @db.Decimal
  elevation_meters              Decimal?            @db.Decimal
  temperature                   Decimal?            @db.Decimal
  ph                            Decimal?            @db.Decimal
  salinity                      Decimal?            @db.Decimal
  salinity_unit                 String?
  dissolved_oxygen              Decimal?            @db.Decimal
  dissolved_oxygen_unit         String?
  nitrate                       Decimal?            @db.Decimal
  nitrate_unit                  String?
  nitrite                       Decimal?            @db.Decimal
  nitrite_unit                  String?
  ammonium                      Decimal?            @db.Decimal
  ammonium_unit                 String?
  phosphate                     Decimal?            @db.Decimal
  phosphate_unit                String?
  conductivity                  Decimal?            @db.Decimal
  conductivity_unit             String?
  dissolved_organic_carbon      Decimal?            @db.Decimal
  dissolved_organic_carbon_unit String?
  filtration_lower_threshold_um Decimal?            @db.Decimal
  filtration_upper_threshold_um Decimal?            @db.Decimal
  current_precipitation_mm      Decimal?            @db.Decimal
  mean_annual_precipitation_mm  Decimal?            @db.Decimal
  mean_annual_temperature       Decimal?            @db.Decimal
  environmental_package         String?
  environment_biome             String?
  environment_feature           String?
  environment_material          String?
  host_taxid                    Int?
  host_scientific_name          String?
  geolocation_name              String?
  sample_alias                  String?
  accession                     String?
  gold_ecosystem_path           String?
  gold_ecosystem_metadata       Json?               @default("{}")
  checkm_completeness           Decimal?            @db.Decimal
  checkm_contamination          Decimal?            @db.Decimal
  genome_size                   BigInt?
  genome_quality                String?
  data_source_ids               String[]            @default([]) @db.Uuid
  metadata                      Json                @default("{}")
  created_at                    DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime?           @default(now()) @db.Timestamptz(6)
  sample_analyses               SampleAnalysis[]
  sample_assemblies             SampleAssembly[]
  sample_biomes                 SampleBiome[]
  sample_measurements           SampleMeasurement[]
  sample_runs                   SampleRun[]
  study_samples                 StudySample[]

  @@index([data_source_ids], map: "idx_samples_data_source_ids_gin", type: Gin)
  @@index([latitude], map: "idx_samples_latitude")
  @@index([longitude], map: "idx_samples_longitude")
  @@index([metadata], map: "idx_samples_metadata_gin", type: Gin)
  @@map("samples")
}

model Run {
  id                  String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  external_id         String?
  name                String?       @db.VarChar(200)
  instrument_model    String?       @db.VarChar(100)
  instrument_platform String?       @db.VarChar(50)
  accession           String?
  secondary_accession String?
  metadata            Json          @default("{}")
  created_at          DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?     @default(now()) @db.Timestamptz(6)
  run_analyses        RunAnalysis[]
  run_assemblies      RunAssembly[]
  run_studies         RunStudy[]
  sample_runs         SampleRun[]

  @@index([metadata], map: "idx_runs_metadata_gin", type: Gin)
  @@map("runs")
}

/// A genome's own resolved lineage lives in `assembly_taxonomy`, read
/// via raw SQL — hence no relation here. Do NOT infer a genome's taxonomy by picking one
/// of its BGCs: for 12.7% of genomes the BGCs disagree, which is the bug 0087 exists to fix.
model Assembly {
  id                    String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  external_id           String?
  name                  String?            @db.VarChar(200)
  source_type           String
  assembly_level        String?            @db.VarChar(50)
  sequencing_technology String?            @db.VarChar(200)
  contig_count          Int?
  accession             String?            @unique
  data_source_ids       String[]           @default([]) @db.Uuid
  metadata              Json               @default("{}")
  created_at            DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?          @default(now()) @db.Timestamptz(6)
  antismash_runs        AntiSmashRun[]
  assembly_analyses     AssemblyAnalysis[]
  bgcs                  Bgc[]
  run_assemblies        RunAssembly[]
  sample_assemblies     SampleAssembly[]

  @@index([data_source_ids], map: "idx_assemblies_data_source_ids_gin", type: Gin)
  @@index([metadata], map: "idx_assemblies_metadata_gin", type: Gin)
  @@index([source_type], map: "idx_assemblies_source_type")
  @@map("assemblies")
}

model Analysis {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  external_id       String?
  name              String?            @db.VarChar(200)
  analysis_type     String             @db.VarChar(100)
  tool_name         String?            @db.VarChar(100)
  tool_version      String?            @db.VarChar(50)
  parameters        String?
  run_date          DateTime?          @db.Date
  accession         String?            @unique
  data_source_ids   String[]           @default([]) @db.Uuid
  metadata          Json               @default("{}")
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?          @default(now()) @db.Timestamptz(6)
  antismash_runs    AntiSmashRun[]
  assembly_analyses AssemblyAnalysis[]
  bgcs              Bgc[]
  run_analyses      RunAnalysis[]
  sample_analyses   SampleAnalysis[]

  @@index([analysis_type], map: "idx_analyses_analysis_type")
  @@index([data_source_ids], map: "idx_analyses_data_source_ids_gin", type: Gin)
  @@index([metadata], map: "idx_analyses_metadata_gin", type: Gin)
  @@index([tool_name], map: "idx_analyses_tool_name")
  @@map("analyses")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Biome {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String        @db.VarChar(200)
  description   String?
  parent_id     String?       @db.Uuid
  level         Int?
  metadata      Json          @default("{}")
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  parent        Biome?        @relation("BiomeHierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      Biome[]       @relation("BiomeHierarchy")
  sample_biomes SampleBiome[]
  study_biomes  StudyBiome[]

  @@index([metadata], map: "idx_biomes_metadata_gin", type: Gin)
  @@index([parent_id], map: "idx_biomes_parent_id")
  @@map("biomes")
}

model SampleMeasurement {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sample_id   String    @db.Uuid
  key         String
  value       String
  unit        String?
  measured_at DateTime? @db.Date
  source      String?
  metadata    Json      @default("{}")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  sample      Sample    @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([key], map: "idx_sample_measurements_key")
  @@map("sample_measurements")
}

model StudySample {
  study_id   String    @db.Uuid
  sample_id  String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  sample     Sample    @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  study      Study     @relation(fields: [study_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([study_id, sample_id])
  @@index([sample_id], map: "idx_study_samples_sample_id")
  @@index([study_id], map: "idx_study_samples_study_id")
  @@map("study_samples")
}

model SampleRun {
  sample_id  String    @db.Uuid
  run_id     String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  run        Run       @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sample     Sample    @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([sample_id, run_id])
  @@index([run_id], map: "idx_sample_runs_run_id")
  @@index([sample_id], map: "idx_sample_runs_sample_id")
  @@map("sample_runs")
}

model RunAssembly {
  run_id      String    @db.Uuid
  assembly_id String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  assembly    Assembly  @relation(fields: [assembly_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  run         Run       @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([run_id, assembly_id])
  @@index([assembly_id], map: "idx_run_assemblies_assembly_id")
  @@index([run_id], map: "idx_run_assemblies_run_id")
  @@map("run_assemblies")
}

model SampleAssembly {
  sample_id   String    @db.Uuid
  assembly_id String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  assembly    Assembly  @relation(fields: [assembly_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sample      Sample    @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([sample_id, assembly_id])
  @@index([assembly_id], map: "idx_sample_assemblies_assembly_id")
  @@index([sample_id], map: "idx_sample_assemblies_sample_id")
  @@map("sample_assemblies")
}

model AssemblyAnalysis {
  assembly_id String    @db.Uuid
  analysis_id String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  analysis    Analysis  @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assembly    Assembly  @relation(fields: [assembly_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([assembly_id, analysis_id])
  @@index([analysis_id], map: "idx_assembly_analyses_analysis_id")
  @@index([assembly_id], map: "idx_assembly_analyses_assembly_id")
  @@map("assembly_analyses")
}

model SampleAnalysis {
  sample_id   String    @db.Uuid
  analysis_id String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  analysis    Analysis  @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sample      Sample    @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([sample_id, analysis_id])
  @@index([analysis_id], map: "idx_sample_analyses_analysis_id")
  @@index([sample_id], map: "idx_sample_analyses_sample_id")
  @@map("sample_analyses")
}

model RunAnalysis {
  run_id      String    @db.Uuid
  analysis_id String    @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  analysis    Analysis  @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  run         Run       @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([run_id, analysis_id])
  @@index([analysis_id], map: "idx_run_analyses_analysis_id")
  @@index([run_id], map: "idx_run_analyses_run_id")
  @@map("run_analyses")
}

model SampleBiome {
  sample_id  String    @db.Uuid
  biome_id   String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  biome      Biome     @relation(fields: [biome_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sample     Sample    @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([sample_id, biome_id])
  @@index([biome_id], map: "idx_sample_biomes_biome_id")
  @@index([sample_id], map: "idx_sample_biomes_sample_id")
  @@map("sample_biomes")
}

model StudyBiome {
  study_id   String    @db.Uuid
  biome_id   String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  biome      Biome     @relation(fields: [biome_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  study      Study     @relation(fields: [study_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([study_id, biome_id])
  @@index([biome_id], map: "idx_study_biomes_biome_id")
  @@index([study_id], map: "idx_study_biomes_study_id")
  @@map("study_biomes")
}

model RunStudy {
  run_id     String    @db.Uuid
  study_id   String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  run        Run       @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  study      Study     @relation(fields: [study_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([run_id, study_id])
  @@index([run_id], map: "idx_run_studies_run_id")
  @@index([study_id], map: "idx_run_studies_study_id")
  @@map("run_studies")
}

model AntiSmashRun {
  id                      String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                    String?             @db.VarChar(200)
  file_path               String?
  analysis_id             String?             @db.Uuid
  assembly_id             String?             @db.Uuid
  num_bgcs                Int?
  pipeline_version        String?             @default("1.0")
  antismash_version       String?
  taxon                   String?             @db.VarChar(50)
  processing_time_seconds Int?
  total_contigs           Int?
  input_filename          String?
  status                  AntiSmashRunStatus? @default(pending)
  created_at              DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?           @default(now()) @db.Timestamptz(6)
  analysis                Analysis?           @relation(fields: [analysis_id], references: [id], onUpdate: NoAction)
  assembly                Assembly?           @relation(fields: [assembly_id], references: [id], onUpdate: NoAction)
  bgcs                    Bgc[]

  @@index([analysis_id], map: "idx_antismash_runs_analysis_id")
  @@index([assembly_id], map: "idx_antismash_runs_assembly_id")
  @@index([status], map: "idx_antismash_runs_status")
  @@map("antismash_runs")
}

model Gcf {
  id                    String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String?        @unique @db.VarChar(200)
  /// Display-only human-readable alias (e.g. 'lightened-sow'). Never an identifier.
  pet_name              String?        @unique @db.VarChar(32)
  description           String?
  representative_bgc_id String?        @db.Uuid
  cluster_method        String?        @db.VarChar(100)
  /// clustering-v3 tier: 'seed' (defined by the truncation seed) | 'fragmented'
  /// (de-novo clusters of the leftovers). Replaces v2's family_origin.
  family_class          String
  /// Does this family get a /gcfs entry and a detail page? False for the 146,360
  /// fragmented singletons and the 34 seed families that exist only as somebody's
  /// secondary hit -- they keep their bgc_gcf rows, they just are not browsable.
  listed                Boolean
  dom_category          String?
  /// PRIMARY members only, so family sizes sum to the placed-BGC count rather than
  /// double-counting secondary memberships.
  n_bgc                 Int?
  created_at            DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?      @default(now()) @db.Timestamptz(6)
  bgc_gcf               BgcGcf[]
  representative_bgc    Bgc?           @relation("GcfRepresentativeBgc", fields: [representative_bgc_id], references: [id], onUpdate: NoAction)
  export_jobs           GcfExportJob[]

  @@index([cluster_method], map: "idx_gcfs_cluster_method")
  @@index([representative_bgc_id], map: "idx_gcfs_representative_bgc_id")
  @@index([family_class], map: "idx_gcfs_family_class")
  @@index([listed], map: "idx_gcfs_listed")
  @@index([n_bgc], map: "idx_gcfs_n_bgc")
  @@map("gcfs")
}

/// clustering-v3 membership. A BGC can belong to SEVERAL families: 2,499,475 of them
/// do (22% of everything the seed tier places), all via the sequence-containment route.
///
/// Under v2 the primary key was (bgc_id, threshold), which structurally allowed only
/// one family per BGC per resolution -- and five query sites still rely on a bgc_gcf
/// join not multiplying rows. That guarantee is preserved by `is_primary` plus a
/// partial unique index `(bgc_id) WHERE is_primary`, NOT by the
/// primary key. Any query that wants one row per BGC must say `AND bg.is_primary`;
/// without it the join fans out silently rather than erroring.
model BgcGcf {
  bgc_id     String  @db.Uuid
  gcf_id     String  @db.Uuid
  /// Raw BiG-SLICE feature distance, LOWER IS BETTER. Not bounded by 0.4 -- birch
  /// assigns rank-0 members out to 1.101.
  distance   Float?
  is_primary Boolean
  /// 0 = primary, then 1.. in best-BITSCORE order. NOT distance order: a secondary
  /// family can be nearer than the primary, because rank comes from bitscore while
  /// distance comes from percent identity. Sort "also in" lists by rank.
  rank       Int     @db.SmallInt
  bgc        Bgc     @relation(fields: [bgc_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gcf        Gcf     @relation(fields: [gcf_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([bgc_id, gcf_id])
  @@index([gcf_id], map: "idx_bgc_gcf_gcf")
  @@map("bgc_gcf")
}

model BgcFeatures {
  bgc_id                 String   @id @db.Uuid
  completeness_class     String?
  route                  String?
  placement_status       String?
  final_cluster_id       String?  @db.Uuid
  n_biosynthetic         Int?
  n_biosynthetic_add     Int?
  n_regulatory           Int?
  n_transport            Int?
  n_resistance           Int?
  n_other                Int?
  hypothetical_count     Int?
  n_pfam_domain          Int?
  n_asdomain             Int?
  n_asmodule             Int?
  asdomain_types_ordered String[]
  sec_met_domains        String[]
  core_gene_types        String[]
  ordered_asdomain_string String?
  cand_kinds             String[]
  n_protoclusters        Int?
  proto_core_span_bp     BigInt?
  hybrid_structure       String?
  contig_length          BigInt?
  contig_edge            Boolean?
  warnings               String[]
  record_id              String?
  region                 Int?
  primary_category       String?
  bgc                    Bgc      @relation(fields: [bgc_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([route], map: "idx_bgc_features_route")
  @@index([placement_status], map: "idx_bgc_features_place")
  @@index([completeness_class], map: "idx_bgc_features_compl")
  @@map("bgc_features")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Bgc {
  id                      String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  filename                String                    @unique
  assembly                String                    @db.Uuid
  analysis_id             String?                   @db.Uuid
  antismash_run_id        String?                   @db.Uuid
  contig                  String
  start_pos               Int
  end_pos                 Int
  core_start_pos          Int?
  core_end_pos            Int?
  product_category        String[]                  @default([])
  product                 String[]                  @default([])
  anchor                  String?                   @db.VarChar(15)
  gc_content              Decimal?                  @db.Decimal(5, 4)
  detection_tool          String?                   @db.VarChar(100)
  cutoff_distance         Int?
  num_cds_features        Int?
  num_domains             Int?
  tax_id                  Int?
  is_complete             Boolean?                  @default(true)
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  analysis                Analysis?                 @relation(fields: [analysis_id], references: [id], onUpdate: NoAction)
  antismash_run           AntiSmashRun?             @relation(fields: [antismash_run_id], references: [id], onUpdate: NoAction)
  assembly_rel            Assembly                  @relation(fields: [assembly], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bgc_gcf                 BgcGcf[]
  features                BgcFeatures?
  representative_of_gcf   Gcf[]                     @relation("GcfRepresentativeBgc")

  @@index([analysis_id], map: "idx_bgcs_analysis_id")
  @@index([antismash_run_id], map: "idx_bgcs_antismash_run_id")
  @@index([assembly], map: "idx_bgcs_assembly")
  @@index([assembly, contig, start_pos, end_pos], map: "idx_bgcs_assembly_coords_btree")
  @@index([contig], map: "idx_bgcs_contig")
  @@index([assembly, contig, start_pos, end_pos], map: "idx_bgcs_coordinates")
  @@index([filename], map: "idx_bgcs_filename")
  @@index([is_complete], map: "idx_bgcs_is_complete")
  @@index([product_category], map: "idx_bgcs_product_category_gin", type: Gin)
  @@index([product], map: "idx_bgcs_product_gin", type: Gin)
  @@index([tax_id], map: "idx_bgcs_tax_id")
  @@map("bgcs")
}

/// Hierarchical GTDB taxonomy lineages used by BGC metadata search and genome collection views.
/// Per-BGC assignment lives in `bgc_taxonomy` (bgcs carries no taxonomy column),
/// which is read via raw SQL — hence no relation back to Bgc here.
model Taxonomy {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  gtdb_lineage String    @unique(map: "uq_gtdb_lineage")
  domain       String?
  phylum       String?
  class        String?
  order_name   String?
  family       String?
  genus        String?
  species      String?
