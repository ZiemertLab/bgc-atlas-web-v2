/// This model contains database comments and tracks background jobs for exporting GCF GBK files as ZIP archives
model GcfExportJob {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  job_id          String    @unique @db.VarChar(100)
  /// 'gcf' (one family's primary members) or 'regions' (a property search's matches)
  kind            String    @default("gcf") @db.VarChar(16)
  /// Set exactly when kind = 'gcf'
  gcf_id          String?   @db.Uuid
  /// kind = 'regions': the {group, sort} exported, and the /search URL it came from
  search_query    Json?
  search_href     String?
  status          String    @default("pending") @db.VarChar(20)
  progress        Int?      @default(0)
  total_bgcs      Int?
  processed_bgcs  Int?      @default(0)
  missing_files   Int?      @default(0)
  output_filename String?   @db.VarChar(255)
  output_path     String?
  file_size_bytes BigInt?
  started_at      DateTime? @db.Timestamptz(6)
  completed_at    DateTime? @db.Timestamptz(6)
  duration_ms     Int?
  error_message   String?
  user_email      String?   @db.VarChar(255)
  user_ip         String?   @db.Inet
  expires_at      DateTime? @db.Timestamptz(6)
  is_deleted      Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  gcf             Gcf?      @relation(fields: [gcf_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([gcf_id], map: "idx_gcf_export_jobs_gcf_id")
  @@index([status], map: "idx_gcf_export_jobs_status")
  @@index([job_id], map: "idx_gcf_export_jobs_job_id")
  @@index([created_at(sort: Desc)], map: "idx_gcf_export_jobs_created_at")
  @@index([expires_at], map: "idx_gcf_export_jobs_expires_at")
  @@map("gcf_export_jobs")
}

