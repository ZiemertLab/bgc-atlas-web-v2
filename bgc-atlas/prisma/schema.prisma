  @@index([e_value], map: "idx_seq_search_results_e_value")
  @@index([identity(sort: Desc)], map: "idx_seq_search_results_identity")
  @@index([session_id, rank], map: "idx_seq_search_results_rank")
  @@index([session_id], map: "idx_seq_search_results_session_id")
}

