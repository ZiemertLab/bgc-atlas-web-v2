# Example environment variables for local development.
# Copy to `.env.local` and fill in real values. Do not commit real secrets.

# -----------------------------------------------------------------------------
# Core database and cache
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://bgc_atlas:password@localhost:5432/bgc_atlas"

REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# -----------------------------------------------------------------------------
# Public URLs and base path
# -----------------------------------------------------------------------------

# Canonical browser origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Absolute app/API base used in emails and generated download links.
# Include the base path when the app is mounted under one.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Public base path when serving the app from a sub-route (e.g. "/atlas").
# Leave empty to serve from the site root. next.config.ts reads this for
# basePath/assetPrefix and src/lib/basePath.ts reads it at runtime, so the two
# can no longer drift. It is inlined at build time: change it and rebuild.
NEXT_PUBLIC_BASE_PATH=""

# CARTO basemap API key for the Leaflet maps. Public client credential — it
# ships in the tile URL the browser requests, and CARTO scopes it to a domain.
# Free for non-commercial/academic use (5M tiles/month): carto.com/basemaps/apikey
# Without it the maps still render, but every tile carries an
# "API KEY REQUIRED" watermark.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=""

# Comma-separated list of origins allowed to load dev assets through a proxy.
NEXT_ALLOWED_DEV_ORIGINS=""

# Enable bundle analyzer for `npm run analyze`.
ANALYZE="false"

# -----------------------------------------------------------------------------
# Search indexes
# -----------------------------------------------------------------------------

# The cluster runs with its security plugin on (scripts/opensearch/README.md):
# https, and the read-only bgc_reader user. Trust for its private CA comes from
# NODE_EXTRA_CA_CERTS, set in ecosystem.config.js -- not from this file.
OPENSEARCH_URL="https://localhost:9200"
OPENSEARCH_USERNAME="bgc_reader"
OPENSEARCH_PASSWORD=""
OPENSEARCH_INDEX="bgc_facets"
OPENSEARCH_VOCAB_INDEX="bgc_facet_vocab"

# Browse indexes (aliases) for /bgcs, /gcfs and /samples.
OPENSEARCH_BGC_BROWSE_INDEX="bgc_browse"
OPENSEARCH_GCF_BROWSE_INDEX="gcf_browse"
OPENSEARCH_SAMPLE_BROWSE_INDEX="sample_browse"

# Serve browse lists from OpenSearch. Unset or anything but "true" falls back to
# the SQL path, which is far slower on the full corpus. Production sets the three
# per-entity flags; OPENSEARCH_BROWSE_ENABLED="true" turns on all three at once.
OPENSEARCH_BROWSE_ENABLED=""
OPENSEARCH_BROWSE_BGCS_ENABLED="true"
OPENSEARCH_BROWSE_GCFS_ENABLED="true"
OPENSEARCH_BROWSE_SAMPLES_ENABLED="true"
METADATA_QUERY_TIMEOUT_MS="300000"

# -----------------------------------------------------------------------------
# Uploads, exports, and temporary working directories
# -----------------------------------------------------------------------------

# Directory where user contribution uploads are stored.
USER_UPLOADS_DIR="/tmp/bgc-atlas-user-uploads"

# Sequence-search session directory.
SESSION_DIR="/tmp/bgc-atlas-sessions"

# BiG-SLiCE upload/session directory.
BIGSLICE_SESSION_DIR="/tmp/bgc-atlas-bigslice-sessions"

# GCF export output and retention.
GCF_EXPORT_DIR="/tmp/bgc-atlas-gcf-exports"
EXPORT_RETENTION_DAYS="7"

# Combined per-member-gzip archive of every region GBK, read by byte offset for
# single-BGC downloads. Built by scripts/export/repack_regions_gbk.py.
COMBINED_GBK_ARCHIVE="/data/bgc-atlas/data-v2/populator-out-sequences/all_regions_gbk.tar.gz"

# The directory nginx serves as /downloads/; /releases and /downloads read
# releases/releases.json and each release's manifest.json from it.
DOWNLOADS_DIR="/data/bgc-atlas/data-v2/populator-out-sequences"

# antiSMASH archive extraction/cache directory.
ANTISMASH_TMP_DIR="/tmp/bgc-antismash"
ANTISMASH_PYTHON="python3"

# Bounds on the extraction cache above, swept hourly. Serving one BGC to the
# region viewer unpacks a whole antiSMASH run: measured 29-127 MB for a GTDB
# genome, 499 MB for an MGnify run, 8.3 GB for a Microflora Danica one.
#
# A run is aged from its LAST SERVE, not its extraction, and the most recently
# served run is never evicted even when it alone exceeds a cap -- otherwise the
# next view re-extracts what the current one just paid for.
#
# NOTE the live deployment points ANTISMASH_TMP_DIR at CephFS, not the /tmp
# default above, so these defaults are not what production runs.
ANTISMASH_CACHE_TTL_HOURS="24"
ANTISMASH_CACHE_MAX_BYTES="4294967296"

# The inode bound, and in practice the one that binds. Bytes and file count are
# badly decoupled: a GTDB genome is 29 MB across ~100 files and re-extracts in
# 0.59s; one Microflora Danica run is 8.3 GB across 46,018 files and takes 84s.
# A cache far under any byte cap can still carry millions of inodes, and this
# share is in the backup set, where a large inode count has caused failures.
# Unset ALL THREE and the sweep is report-only -- it never deletes on a bound
# nobody chose.
ANTISMASH_CACHE_MAX_FILES="500000"

# -----------------------------------------------------------------------------
# Email and notifications
# -----------------------------------------------------------------------------

# If SMTP is not configured, contribution uploads are still saved but emails fail.
#
# FROM_EMAIL must be an address whose domain authorises the relay the mail
# leaves through, or it fails SPF and is silently spam-filed.
FROM_EMAIL="BGC Atlas <no-reply@example.com>"
#
# Prefer a local relay that holds the SMTP credentials itself, so the app's
# environment carries none: leave SMTP_USER/SMTP_PASS unset in that case. Auth is
# optional in all senders; set the pair only to talk to a remote server directly.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"

# CC address for contribution notifications.
CONTRIBUTION_CC="admin@example.com"

# Recipient(s) of /api/feedback. Falls back to CONTRIBUTION_CC when unset.
FEEDBACK_TO=""

# -----------------------------------------------------------------------------
# Background worker
# -----------------------------------------------------------------------------

# The BullMQ search/export worker and node-cron jobs start inside `next start`.
# Every server that boots joins the same Redis queues, so set this to "1" in any
# second (preview/test) checkout or it will take production jobs.
SEARCH_WORKER_DISABLED=""

# Status endpoint of the legacy v1 site's job queue, shown on the queue page.
V1_QUEUE_STATUS_URL="https://bgc-atlas.cs.uni-tuebingen.de/v1/jobs/queue/status"

# -----------------------------------------------------------------------------
# Sequence search: shared execution settings
# -----------------------------------------------------------------------------

# local = conda envs on the app host; ssh-docker = Docker on a remote SSH host.
SEQSEARCH_EXEC_MODE="local"
SEQSEARCH_THREADS="16"
SEQSEARCH_SSH_HOST="docker-host"
SEQSEARCH_CEPH_MOUNT="/data/bgc-atlas"
SEQSEARCH_DOCKER_USER=""

# -----------------------------------------------------------------------------
# DIAMOND search
# -----------------------------------------------------------------------------

DIAMOND_PROTEIN_DB="/path/to/diamond/protein/bgc_proteins_db"
DIAMOND_CONDA_ENV="diamond"
DIAMOND_TMP_DIR="/tmp/bgc-atlas-diamond"
DIAMOND_BLOCK_SIZE=""
DIAMOND_DOCKER_IMAGE="diamond:latest"
DIAMOND_DOCKER_PULL=""

# -----------------------------------------------------------------------------
# BiG-SLiCE search
# -----------------------------------------------------------------------------

# One query workspace per clustering-v3 model. Each holds result/data.db symlinked to the
# read-only model bundle, a prebuilt result/cache/gcf_models_1.pkl (see
# scripts/bigslice-query/README.md -- the search returns WRONG distances without it), and
# a writable reports/. Uploads are queried against seed first; residual is queried only
# for the ones seed cannot place within 0.4.
BIGSLICE_SEED_DIR="/tmp/bgc-atlas-bigslice-query/seed"
BIGSLICE_RESIDUAL_DIR="/tmp/bgc-atlas-bigslice-query/residual"
BIGSLICE_THREADS="16"
BIGSLICE_RUN_ID="1"   # clustering 1 in both workspaces = the 0.4 models
BIGSLICE_EXEC_MODE="local"
BIGSLICE_SSH_HOST="docker-host"
BIGSLICE_DOCKER_IMAGE="bigslice:2.0.2"
BIGSLICE_CEPH_MOUNT="/data/bgc-atlas"
BIGSLICE_PROGRAM_DB_FOLDER="/opt/bigslice-models"
BIGSLICE_DOCKER_USER=""
BIGSLICE_BUILD_CONTEXT="/path/to/docker/bigslice"
BIGSLICE_PYTHON="python3"
BIGSLICE_PARSE_SCRIPT=""

# Local conda env used by BiG-SLiCE local mode.
CONDA_ENV_NAME="bigslice"
