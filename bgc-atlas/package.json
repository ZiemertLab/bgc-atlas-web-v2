{
  "name": "bgc-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true next build",
    "sync:bgc-viewer-assets": "cp node_modules/@kretep/bgc-viewer-components/dist/web-components/style.css node_modules/@kretep/bgc-viewer-components/dist/web-components/domain-colors.csv public/vendor/bgc-viewer/"
  },
  "overridesComment": "Radix pins dismissable-layer and focus-guards to exact versions per package, so npm nests a second copy under react-popover. Those modules hold a module-level layer stack; two copies means a Popover inside a modal Dialog never re-enables pointer events and its options become unclickable. Keep them deduped.",
  "overrides": {
    "@radix-ui/react-dismissable-layer": "1.1.11",
    "@radix-ui/react-focus-guards": "1.1.3"
  },
